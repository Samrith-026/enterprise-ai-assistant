# Copy to .env for Docker Compose. Export these separately for the local JVM.
# Supply your own key; there is deliberately no default API key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=enterprise_dev
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
